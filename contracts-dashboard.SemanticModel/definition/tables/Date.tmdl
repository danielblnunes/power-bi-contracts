	hierarchy 'Date Hierarchy'
		lineageTag: c2d344af-cea0-4d7d-8f23-05d00bd0aae5

		level Year
			lineageTag: 41d90dc1-2e5d-436c-8098-3cc6c63f5027
			column: Year

		level Quarter
			lineageTag: 9058884e-1b56-4b58-be40-c6bef76e6370
			column: Quarter

		level Month
			lineageTag: 960dad9e-e07b-4e64-9805-227b0a702350
			column: Month

		level Day
			lineageTag: 9630af5d-262d-4835-9f5b-d7bba4f0908d
			column: Day

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2025, 1, 1), DATE(2030, 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter Number", QUARTER([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Week Number", WEEKNUM([Date]),
				    "Day", DAY([Date]),
				    "Fiscal Year", YEAR([Date]) + IF(MONTH([Date]) >= 7, 1, 0),
				    "Fiscal Quarter Number", QUOTIENT(MOD(MONTH([Date]) - 7 + 12, 12), 3) + 1,
				    "Fiscal Quarter", "FQ" & (QUOTIENT(MOD(MONTH([Date]) - 7 + 12, 12), 3) + 1)
				)

