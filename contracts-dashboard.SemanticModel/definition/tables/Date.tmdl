/// Date dimension generated by powerbi-mcp (2025-01-01 to 2030-12-31).
table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = User

	column 'Quarter Number'
		dataType: int64
		summarizeBy: none
		isHidden
		isNameInferred
		sourceColumn: [Quarter Number]

		annotation SummarizationSetBy = User

	column Quarter
		dataType: string
		summarizeBy: none
		sortByColumn: 'Quarter Number'
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = User

	column 'Month Number'
		dataType: int64
		summarizeBy: none
		isHidden
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = User

	column Month
		dataType: string
		summarizeBy: none
		sortByColumn: 'Month Number'
		isNameInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = User

	column 'Week Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Number]

		annotation SummarizationSetBy = User

	column Day
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day]

		annotation SummarizationSetBy = User

	column 'Fiscal Year'
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year]

		annotation SummarizationSetBy = User

	column 'Fiscal Quarter Number'
		dataType: int64
		summarizeBy: none
		isHidden
		isNameInferred
		sourceColumn: [Fiscal Quarter Number]

		annotation SummarizationSetBy = User

	column 'Fiscal Quarter'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Fiscal Quarter Number'
		isNameInferred
		sourceColumn: [Fiscal Quarter]

		annotation SummarizationSetBy = User

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2025, 1, 1), DATE(2030, 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter Number", QUARTER([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Week Number", WEEKNUM([Date]),
				    "Day", DAY([Date]),
				    "Fiscal Year", YEAR([Date]) + IF(MONTH([Date]) >= 7, 1, 0),
				    "Fiscal Quarter Number", QUOTIENT(MOD(MONTH([Date]) - 7 + 12, 12), 3) + 1,
				    "Fiscal Quarter", "FQ" & (QUOTIENT(MOD(MONTH([Date]) - 7 + 12, 12), 3) + 1)
				)
