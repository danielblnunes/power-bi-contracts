/// Date dimension generated by powerbi-mcp (2025-01-01 to 2030-12-31).
table Date
	lineageTag: 1427eb80-015d-45e3-9f5e-4cbf26b4d933
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: cc7f4c67-2741-437a-9479-3a4d1f564bbf
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 632e32fb-8b8b-4282-829e-7e598a89f661
