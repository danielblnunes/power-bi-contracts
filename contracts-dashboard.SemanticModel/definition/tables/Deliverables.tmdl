table Deliverables
	lineageTag: 5e8e99c6-db1d-4c43-94b9-260fa3b38a0c

	measure 'Total Deliverables' = COUNTROWS(Deliverables)
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: 5438f79b-cb0b-46e5-8cbf-fdbd28b43081

	measure 'Delivered Count' = CALCULATE([Total Deliverables], Deliverables[Status] = "Delivered")
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: 508e9b09-c77c-433f-b3cf-58b1af50358e

	measure 'In Progress Count' = CALCULATE([Total Deliverables], Deliverables[Status] = "In Progress")
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: c5cbc89a-9635-41a5-8145-44481ae26030

	measure 'Not Started Count' = CALCULATE([Total Deliverables], Deliverables[Status] = "Not Started")
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: a4506da9-b633-4565-952c-93d99545c6ed

	measure 'Overdue Deliverables Count' = CALCULATE([Total Deliverables], Deliverables[Status] = "Overdue")
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: 6774cf57-b793-428e-9646-d50dbc2962b9

	measure 'Applicable Deliverables' = CALCULATE([Total Deliverables], Deliverables[Applicable] = "Yes")
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: d1991e9f-0404-493d-9645-9025c30ffc01

	measure 'Completion Rate' = DIVIDE([Delivered Count], [Applicable Deliverables])
		formatString: 0.0%
		displayFolder: Deliverables
		lineageTag: 4e6eeb2e-a680-4b16-a41d-ac841126f8cd

	measure 'Total VIK Value' = CALCULATE(SUM(Deliverables[Value_AED]), Deliverables[Item_Group] = "VIK")
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: 493cf30f-8eaa-48f2-a903-687403c29248

	measure 'Total Deliverable Value' = SUM(Deliverables[Value_AED])
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: 6f8a2125-fb37-4693-8346-21fee5971a54

	measure 'Avg Deliverable Value' = AVERAGEX(Deliverables, Deliverables[Value_AED])
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: 468a9cf3-3746-4512-823f-6dd28e1a4d58

	measure 'Deliverables Due 30d' = CALCULATE([Total Deliverables], Deliverables[Due_Date] >= TODAY(), Deliverables[Due_Date] <= TODAY() + 30, Deliverables[Status] <> "Delivered")
		formatString: #,##0
		displayFolder: Delivery
		lineageTag: dff03dfb-6cc1-4d17-a631-50e0cdd02404

	measure 'Deliverables Past Due' = CALCULATE([Total Deliverables], Deliverables[Due_Date] < TODAY(), Deliverables[Status] <> "Delivered")
		formatString: #,##0
		displayFolder: Delivery
		lineageTag: 3edf6a45-5f48-475c-8dc8-03ef539a2784

	measure 'Deliverables Without Evidence' = CALCULATE([Delivered Count], Deliverables[Evidence_Link] = BLANK())
		formatString: #,##0
		displayFolder: Compliance
		lineageTag: 10451dd6-deaa-4cc3-8000-b264d29a53d4

	measure 'Avg VIK Value Per Item' = DIVIDE([Total VIK Value], CALCULATE([Total Deliverables], Deliverables[Item_Group] = "VIK"))
		formatString: #,##0
		displayFolder: Deliverables
		lineageTag: d4d1d0a6-68f7-4666-82e8-f3644df01a59

	measure 'Items Not Applicable' = CALCULATE([Total Deliverables], Deliverables[Applicable] = "No")
