	partition Deliverables = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\danie\Code\power-bi-contracts\contracts_data_collection_template.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "DeliverablesTable", Kind = "Table"]}[Data],
				  #"Changed column type" = Table.TransformColumnTypes(#"Navigation 1", {{"Item_ID", type text}, {"Agreement_ID", type text}, {"Item_Group", type text}, {"Item_Category", type text}, {"Item_Name", type text}, {"Description", type text}, {"Quantity", Int64.Type}, {"Unit", type text}, {"Value_AED", Int64.Type}, {"Frequency", type text}, {"Season", type text}, {"Owner", type text}, {"Responsible_Party", type text}, {"Applicable", type text}, {"Status", type text}, {"Date_Delivered", type date}}, "en-US"),
				  #"Replaced Value" = Table.ReplaceValue(#"Changed column type", "600 Delivered", "Delivered", Replacer.ReplaceText, {"Status"}),
				  #"Changed Due_Date Type" = Table.TransformColumns(#"Replaced Value", {{"Due_Date", each try Date.From(_) otherwise null, type nullable date}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Due_Date Type", each [Item_ID] <> null and [Item_ID] <> "")
				in
				  #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

	/// Dynamic title for the Deliverables Report page based on Item_Group slicer.
	measure 'Deliverables Report Title' =
			VAR _sel = SELECTEDVALUE(Deliverables[Item_Group])
			RETURN IF(_sel = BLANK(), "Deliverables — All Categories", "Deliverables — " & _sel)
		displayFolder: Reporting
