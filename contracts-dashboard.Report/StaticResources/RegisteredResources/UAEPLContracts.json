{
  "name": "UAEPL Contracts",
  "dataColors": [
    "#0B2545",
    "#C8A030",
    "#1B998B",
    "#C44536",
    "#5B5EA6",
    "#9B59B6",
    "#3498DB",
    "#95A5A6",
    "#E67E22",
    "#16A085",
    "#2C3E50",
    "#D35400"
  ],
  "background": "#FFFFFF",
  "foreground": "#212529",
  "tableAccent": "#0B2545",
  "good": "#1B998B",
  "neutral": "#C8A030",
  "bad": "#C44536",
  "maximum": "#1B998B",
  "center": "#C8A030",
  "minimum": "#C44536",
  "null": "#9E9E9E",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0,
            "show": true
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E0E0E0"
              }
            },
            "show": true,
            "radius": 4
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#E0E0E0"
              }
            },
            "transparency": 0,
            "show": true
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "alignment": "left",
            "bold": true,
            "show": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "displayUnit": "Auto",
            "precision": 0
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "background": {
              "solid": {
                "color": "#F8F9FA"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "background": {
              "solid": {
                "color": "#F8F9FA"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "bold": true
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 14,
            "bold": true
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 10
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 14,
            "bold": true
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 10
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 14,
            "bold": true
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "labels": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 11
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 14,
            "bold": true
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "verticalGrid": {
              "color": {
                "solid": {
                  "color": "#E0E0E0"
                }
              }
            },
            "horizontalGrid": {
              "color": {
                "solid": {
                  "color": "#E0E0E0"
                }
              }
            },
            "rowPadding": 4
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "alignment": "left"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "alignment": "left"
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#212529"
              }
            },
            "fontSize": 14,
            "bold": true
          }
        ]
      }
    }
  }
}