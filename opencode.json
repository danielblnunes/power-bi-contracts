{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "powerbi": {
      "type": "local",
      "command": ["python3.10", "src/server.py"],
      "cwd": "./powerbi-mcp",
      "environment": {
        "PYTHONPATH": "./powerbi-mcp/src",
        "POWERBI_MCP_READONLY": "false"
      },
      "timeout": 30000
    }
  }
}
