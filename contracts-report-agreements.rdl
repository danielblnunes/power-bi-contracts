    <DataSet Name="AgreementPayments">
      <Query>
        <DataSourceName>Legal_contractsdashboard</DataSourceName>
        <CommandText>EVALUATE
FILTER(
    Payments,
    Payments[Agreement_ID] = @AgreementID
)
ORDER BY
    Payments[Payment_Sequence]</CommandText>
      </Query>
      <Fields>
        <Field Name="Payments_Payment_ID_"><rd:TypeName>System.String</rd:TypeName><DataField>Payments[Payment_ID]</DataField></Field>
