  <DataSets>
    <DataSet Name="AgreementDetail">
      <Query>
        <DataSourceName>contractsdashboard</DataSourceName>
        <CommandText>EVALUATE
FILTER(
    Agreements,
    Agreements[Agreement_ID] = @AgreementID
)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Agreement_ID"><DataField>Agreement_ID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Agreement_Type"><DataField>Agreement_Type</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Counterparty_Name"><DataField>Counterparty_Name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Agreement_Title"><DataField>Agreement_Title</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Contract_Category"><DataField>Contract_Category</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Department_Owner"><DataField>Department_Owner</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Legal_Owner"><DataField>Legal_Owner</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Commercial_Owner"><DataField>Commercial_Owner</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Start_Date"><DataField>Start_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="End_Date"><DataField>End_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Term_Months"><DataField>Term_Months</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="Total_Contract_Value_AED"><DataField>Total_Contract_Value_AED</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="Annual_Value_AED"><DataField>Annual_Value_AED</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="Payment_Frequency"><DataField>Payment_Frequency</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Renewal_Option"><DataField>Renewal_Option</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Auto_Renewal"><DataField>Auto_Renewal</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Notice_Period_Days"><DataField>Notice_Period_Days</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="Confidentiality_Level"><DataField>Confidentiality_Level</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Next_Action"><DataField>Next_Action</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Next_Action_Date"><DataField>Next_Action_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Notes"><DataField>Notes</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="AgreementDeliverables">
      <Query>
        <DataSourceName>contractsdashboard</DataSourceName>
        <CommandText>EVALUATE
FILTER(
    Deliverables,
    Deliverables[Agreement_ID] = @AgreementID
)
ORDER BY 
    Deliverables[Item_Group],
    Deliverables[Item_Name]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_ID"><DataField>Item_ID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Agreement_ID"><DataField>Agreement_ID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Item_Group"><DataField>Item_Group</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Item_Category"><DataField>Item_Category</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Item_Name"><DataField>Item_Name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Description"><DataField>Description</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="Unit"><DataField>Unit</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Value_AED"><DataField>Value_AED</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="Frequency"><DataField>Frequency</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Due_Date"><DataField>Due_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Season"><DataField>Season</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Owner"><DataField>Owner</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Responsible_Party"><DataField>Responsible_Party</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Applicable"><DataField>Applicable</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Date_Delivered"><DataField>Date_Delivered</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="AgreementPayments">
      <Query>
        <DataSourceName>contractsdashboard</DataSourceName>
        <CommandText>EVALUATE
FILTER(
    Payments,
    Payments[Agreement_ID] = @AgreementID
)
ORDER BY
    Payments[Payment_Sequence]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Payment_ID"><DataField>Payment_ID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Agreement_ID"><DataField>Agreement_ID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Payment_Sequence"><DataField>Payment_Sequence</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="Season"><DataField>Season</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Payment_Type"><DataField>Payment_Type</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Milestone"><DataField>Milestone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Due_Date"><DataField>Due_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Invoice_Date"><DataField>Invoice_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Payment_Date"><DataField>Payment_Date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Amount_AED"><DataField>Amount_AED</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="VAT_AED"><DataField>VAT_AED</DataField><rd:TypeName>System.Double</rd:TypeName></Field>
        <Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Days_To_Due"><DataField>Days_To_Due</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <DataSet Name="AgreementList">
      <Query>
        <DataSourceName>contractsdashboard</DataSourceName>
        <CommandText>EVALUATE
SELECTCOLUMNS(
    Agreements,
    "Agreement_ID", Agreements[Agreement_ID]
)
ORDER BY
    [Agreement_ID]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Agreement_ID"><DataField>Agreement_ID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>

  </DataSets>
  <ReportParameters>
    <ReportParameter Name="AgreementID">
      <DataType>String</DataType>
      <Prompt>Agreement ID</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>AgreementList</DataSetName>
          <ValueField>Agreement_ID</ValueField>
          <LabelField>Agreement_ID</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
